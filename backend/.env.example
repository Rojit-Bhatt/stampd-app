# Runtime
NODE_ENV=development
PORT=5001
PLATFORM_NAME=Stampd
PLATFORM_TIMEZONE=Asia/Kathmandu
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Persistence and authentication
# Leave MONGODB_URI empty for the local in-memory fallback.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-development-secret
# Separate secret for global sessions (customers + company owners across
# tenants). Must differ from JWT_SECRET — global tokens can never satisfy
# the tenant auth middleware even before secret verification.
JWT_GLOBAL_SECRET=replace-with-another-long-random-development-secret

# Optional startup data
SEED_DEMO_DATA=true
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Optional Google identity and location integrations
GOOGLE_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional email delivery
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@stampd.co

# Optional browser push notifications
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:support@stampd.co
