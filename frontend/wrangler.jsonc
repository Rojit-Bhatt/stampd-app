{
  // Cloudflare Workers Static Assets config — the current recommended way to
  // deploy a plain SPA on Cloudflare (Pages' Git-connect wizard has been
  // folded into the Workers dashboard for new projects; the deploy mechanism
  // is the same "wrangler deploy" either way). The "main" worker forwards
  // every /api/* call to the real Render backend and hands everything else
  // to the static assets; the build embeds VITE_API_BASE_URL so browser
  // fetches are absolute (the worker proxy is a safety net, not the path).
  "name": "stampd",
  "compatibility_date": "2025-06-05",
  // The SPA + /api proxy worker. Without `main`, wrangler deploys an
  // assets-only worker and ALL /api calls from the browser return the SPA
  // HTML (the bug behind the "0 active outlets" screen). Keep this pointer
  // whenever deploying — the proxy is load-bearing.
  "main": "worker/worker.js",
  // Build must embed the real API origin: the worker proxies /api as a
  // safety net, but VITE_API_BASE_URL makes fetches absolute (cross-origin)
  // so Cloudflare's static-asset edge never intercepts them with HTML.
  "build": {
    "command": "VITE_API_BASE_URL=https://api.stampdd.club pnpm run build"
  },
  "assets": {
    "directory": "./dist",
    // Client-side-routed deep links (e.g. a scanned QR pointing at
    // /coffesarowar/durbarmarg/claim?token=...) resolve to the SPA shell
    // instead of a 404 — same job public/_redirects does for classic Pages.
    "not_found_handling": "single-page-application",
    // Same security header set as public/_headers (keep in sync). CSP is
    // report-only by design — see public/_headers for the rollout plan.
    "headers": [
      {
        "pattern": ".*",
        "headers": {
          "X-Content-Type-Options": "nosniff",
          "X-Frame-Options": "SAMEORIGIN",
          "Referrer-Policy": "strict-origin-when-cross-origin",
          "Permissions-Policy": "camera=(self), microphone=(), geolocation=(self)",
          "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' https://accounts.google.com https://*.googleapis.com 'unsafe-inline' https://*.google-analytics.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://accounts.google.com https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://accounts.google.com https://www.google-analytics.com https://*.googleapis.com https://api.stampdd.club; frame-src 'self' https://accounts.google.com; worker-src 'self'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'; report-uri /api/csp-report"
        }
      }
    ]
  },
  // INVARIANT — single-pass compression at the edge: Cloudflare auto-
  // compresses these static JS/CSS assets (gzip/br) before sending them.
  // The Vite build must NOT emit pre-compressed artifacts (.gz/.br copies
  // of JS/CSS) — keep outputs plain so the edge compresses exactly once.
  // The API's dynamic JSON is gzip-compressed by the server itself (Express
  // `compression`, backend/server.js) and Cloudflare passes it through.
  // The API also caches its own repetitive dynamic reads (public menu,
  // tenant info, public plans) in memory via backend/utils/responseCache.js
  // — the CDN can't hold this JSON, but the server's Cache-Control:
  // public, max-age=300 lets Cloudflare front it when one is added, and any
  // content edit purges the server-side key so the edge never outruns the
  // source of truth (see backend/tests/response-cache.js).
  // If a build tool ever starts emitting pre-compressed files, add them to
  // ignore and keep only plain outputs, or responses would be double-
  // compressed.
}
